<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Dalamud.NET.Sdk/15.0.0">
  <PropertyGroup>
    <Version>0.2.3.0</Version>
    <!-- Keep the packaged zip free of non-Windows sqlite natives, without
         moving the output path Dalamud's dev plugin registration points at. -->
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>
    <Description>Chat replacement: tabbed chat with per-person tell tabs, command autocompletion, persistent history.</Description>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <!-- :sob:-style emotes: shortcode → emoji map (generated from gemoji)
         and the Twemoji 72x72 PNGs it references, bundled so nothing is
         ever fetched at runtime. -->
    <EmbeddedResource Include="Data\emotes.json" />
    <EmbeddedResource Include="Data\emotes.zip" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.9" />
    <!-- Override the vulnerable transitive native sqlite lib (NU1903). -->
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" Version="3.0.3" />
  </ItemGroup>

  <!-- Dalamud's plugin load context probes the plugin directory for native
       libraries, so the sqlite native dll must sit next to the plugin dll. -->
  <Target Name="CopySqliteNative" AfterTargets="Build">
    <Copy SourceFiles="$(OutputPath)runtimes\win-x64\native\e_sqlite3.dll"
          DestinationFolder="$(OutputPath)"
          Condition="Exists('$(OutputPath)runtimes\win-x64\native\e_sqlite3.dll')" />
  </Target>
</Project>
